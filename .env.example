# Copy to .env locally. Never commit real API keys.
# Compose reads this project-root file into the backend at runtime. Frontend
# assets never receive these secrets. Existing .env values override local defaults.
# FRONTEND_PORT=5173
# BACKEND_PORT=8000
FACTORYOS_API_URL=http://127.0.0.1:8000
# NVIDIA_API_KEY=
# NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NEMOTRON_MAX_ROUNDS=6
# NEMOTRON_MAX_TOOL_CALLS=8
# NEMOTRON_REQUEST_TIMEOUT_SECONDS=90
# NEMOTRON_BUDGET_SECONDS=300
# NEMOTRON_MAX_TOKENS=16384
# NEMOTRON_ENABLE_THINKING=true
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_REQUEST_TIMEOUT_SECONDS=90
# GEMINI_MAX_TOKENS=8192
# Named human reviewers: map reviewer IDs to SHA-256 digests of unique strong bearer tokens.
# FACTORYOS_APPROVERS_JSON={"local-reviewer":"sha256:<64 lowercase hex characters>"}
# JIRA_API_TOKEN=
# SLACK_WEBHOOK_URL=
# MONGODB_URI=
# MONGODB_DATABASE=factoryos
# MONGODB_INCIDENTS_COLLECTION=incidents
# MONGODB_REPAIR_JOBS_COLLECTION=repair_jobs
# MONGODB_INVESTIGATION_JOBS_COLLECTION=investigation_jobs
# MONGODB_REVIEW_JOBS_COLLECTION=review_jobs
# TIGERDATA_DATABASE_URL=
# TIGERDATA_SCHEMA=factoryos
# FACTORYOS_TEST_MONGODB_URI=
# FACTORYOS_TEST_TIGERDATA_URL=
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Jira configuration (backend only; never VITE_*).
# JIRA_BASE_URL=https://YOUR-SITE.atlassian.net
# JIRA_EMAIL=YOUR-ATLASSIAN-EMAIL
# JIRA_API_TOKEN=YOUR-TOKEN
# JIRA_PROJECT_KEY=KAN

# Slack bot (backend only)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# RepairProof Devnet: leave disabled until a specific live transaction is approved.
SOLANA_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional independent verification RPC; defaults to SOLANA_RPC_URL.
SOLANA_VERIFY_RPC_URL=https://api.devnet.solana.com
SOLANA_EXPECTED_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
SOLANA_ALLOWED_PUBLISHER=
# Absolute private path outside the repository; existing Solana CLI 64-byte JSON.
SOLANA_PUBLISHER_KEYPAIR_PATH=
SOLANA_MAX_FEE_LAMPORTS=10000
SOLANA_RPC_TIMEOUT_SECONDS=10
