# Copy to .env.docker. These values are backend-only, never frontend build args.
# Defaults use the local MongoDB service. Override to use your existing Atlas DB:
# MONGODB_URI=mongodb+srv://...
# MONGODB_DATABASE=factoryos
# TIGERDATA_DATABASE_URL=postgres://...
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# FACTORYOS_APPROVERS_JSON={"person-2":"sha256:<token digest>"}
# JIRA_BASE_URL=https://YOUR-SITE.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=KAN
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
